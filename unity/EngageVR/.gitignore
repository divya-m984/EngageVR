# Unity-generated directories. None of these belong in version control:
# they are machine-specific caches, import artefacts, or build output.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Crash reports and build reports
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Asset import artefacts
*.apk
*.aab
*.unitypackage
*.app
